<ns0:text><ns0:body><ns0:div type="edition" xml:lang="grc" n="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7"><ns0:div type="textpart" subtype="book" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7" n="7"><ns0:div type="textpart" subtype="epigram" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7:7" n="547">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">τὰν στάλαν ἐχάραξε Βιάνωρ οὐκ ἐπὶ ματρί,</ns0:l>
<ns0:l n="2">οὐδʼ ἐπὶ τῷ γενέτᾳ, πότμον ὀφειλόμενον,</ns0:l>
<ns0:l n="3">παρθενικᾷ δʼ ἐπὶ παιδί· κατέστενε δʼ, οὐχ Ὑμεναίῳ,</ns0:l>
<ns0:l n="4">ἀλλʼ Ἀίδᾳ νύμφαν δωδεκέτιν κατάγων.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="epigram" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7:7" n="548">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">
<ns0:label type="speaker">α.</ns0:label>
</ns0:l>
<ns0:l n="2">τίς Δαίμων Ἀργεῖος ἐπʼ ἠρίῳ; ἆρα σύναιμος</ns0:l>
<ns0:l n="3">ἐστὶ Δικαιοτέλους; <ns0:label type="speaker">β.</ns0:label> ἐστὶ Δικαιοτέλους.</ns0:l>
<ns0:l n="4">
<ns0:label type="speaker">α.</ns0:label>
</ns0:l>
<ns0:l n="5">ἠχὼ τοῦτʼ ἐλάλησε πανύστατον, ἢ τόδʼ ἀληθές,</ns0:l>
<ns0:l n="6">κεῖνος ὅδʼ ἐστὶν ἀνήρ; <ns0:label type="speaker">β.</ns0:label>  κεῖνος ὅδʼ ἐστὶν ἀνήρ. </ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="epigram" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7:7" n="549">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">Πέτρος ἔτʼ ἐν Σιπύλῳ Νιόβη θρήνοις ἀναλύζει</ns0:l>
<ns0:l n="2">ἑπτὰ δὶς ὠδίνων δυρομένη θάνατον</ns0:l>
<ns0:l n="3">λήξει δʼ οὐδʼ αἰῶνι γόου. τί δʼ ἀλαζόνα μῦθον</ns0:l>
<ns0:l n="4">φθέγξατο, τὸν ζωῆς ἅρπαγα καὶ τεκέων ;</ns0:l>
<ns0:pb n="v.2.p.296" />
</ns0:div>
<ns0:div type="textpart" subtype="epigram" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc7:7" n="550">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">Ναυηγὸς γλαυκοῖο φυγὼν Τρίτωνος ἀπειλὰς</ns0:l>
<ns0:l n="2">Ἀνθεὺς Φθιώτην οὐ φύγεν αἰνόλυκον·</ns0:l>
<ns0:l n="3">Πηνειοῦ παρὰ χῦμα γὰρ ὤλετο. φεῦ τάλαν ὅστις</ns0:l>
<ns0:l n="4">Νηρεΐδων Νύμφας ἔσχεν ἀπιστοτέρας.</ns0:l>
</ns0:div>
</ns0:div></ns0:div></ns0:body></ns0:text></ns0:TEI>