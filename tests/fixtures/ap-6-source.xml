<ns0:text><ns0:body><ns0:div type="edition" xml:lang="grc" n="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6"><ns0:div type="textpart" subtype="book" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6" n="6"><ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="321">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">θύει σοι τόδε γράμμα γενεθλιακαῖσιν ἐν ὥραις,</ns0:l>
<ns0:l n="2"> Καῖσαρ, Νειλαίη Μοῦσα Λεωνίδεω.</ns0:l>
<ns0:l n="3"> Καλλιόπης γὰρ ἄκαπνον ἀεὶ θύος. εἰς δὲ νέωτα,</ns0:l>
<ns0:l n="4">ἢν ἐθέλῃς, θύσει τοῦδε περισσότερα.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="324">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">πέμματα τίς  λιπόωντα, τίς  Ἄρεϊ τῷ πτολιπόρθῳ</ns0:l>
<ns0:l n="2"> βότρυς, τίς  δὲ ῥόδων θῆκεν ἐμοὶ κάλυκας;</ns0:l>
<ns0:l n="3"> νύμφαις ταῦτα φέροι τις ἀναιμάκτους δὲ θυηλὰς</ns0:l>
<ns0:l n="4">οὐ δέχομαι βωμοῖς ὁ θρασύμητις Ἄρης.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="325">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">ἄλλος ἀπὸ σταλίκων, ὁ δʼ ἀπʼ ἠέρος, ὃς δʼ ἀπὸ πόντου,</ns0:l>
<ns0:l n="2"> Εὔπολι, σοὶ πέμπει δῶρα γενεθλίδια·</ns0:l>
<ns0:l n="3"> ἀλλʼ ἐμέθεν δέξαι Μουσῶν στίχον, ὅστις ἐς αἰεὶ</ns0:l>
<ns0:l n="4"> μίμνει, καὶ φιλίης σῆμα καὶ εὐμαθίης.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="326">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">Λὐκτιον ἰοδόκην καὶ καμπύλον, Ἄρτεμι, τόξον</ns0:l>
<ns0:l n="2"> Νῖκις ὁ Λυσιμάχου παῖς ἀνέθηκε Λίβυς·</ns0:l>
<ns0:l n="3"> ἰοὺς γὰρ πλήθοντας ἀεὶ λαγόνεσσι φαρέτρης</ns0:l>
<ns0:l n="4">δορκάσι καὶ βαλίαις ἐξεκένωσ’ ἐλάφοις.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="327">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">εἷς πρὸς ἕνα ψήφοισιν ἰσάζεται, οὐ δύο δοιοῖς</ns0:l>
<ns0:l n="2">οὐ γὰρ ἔτι στέργω τὴν δολιχογραφίην.</ns0:l>
</ns0:div>
<ns0:div type="textpart" subtype="chapter" xml:base="urn:cts:greekLit:tlg7000.tlg001.perseus-grc6:6" n="329">
<ns0:docAuthor xml:lang="lat">
<ns0:persName xml:lang="lat" key="tlg-1457">
<ns0:foreign xml:lang="lat">Julius Leonidas</ns0:foreign>
</ns0:persName>
</ns0:docAuthor>
<ns0:l n="1">ἄλλος μὲν κρύσταλλον, ὁ δʼ ἄργυρον, οἱ δὲ τοπάζους</ns0:l>
<ns0:l n="2"> πέμψουσιν, πλούτου δῶρα γενεθλίδια·</ns0:l>
<ns0:l n="3">ἀλλʼ ἴδʼ Ἀγρειππίνῃ δύο δίστιχα μοῦνον ἰσώσας,</ns0:l>
<ns0:l n="4">ἀρκοῦμαι δώροις, ἃ φθόνος οὐ δαμάσει.</ns0:l>
</ns0:div>
</ns0:div></ns0:div></ns0:body></ns0:text></ns0:TEI>